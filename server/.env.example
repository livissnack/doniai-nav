# 与前端 VUE_APP_SERVER_URL / WEB_PORT 保持一致
PORT=3001

# 可选：额外 CORS 来源（逗号分隔）
# CORS_ALLOWED_ORIGINS=http://172.16.5.27:1343

# AUTH_TOKEN=your-token

# 用户登录 JWT 密钥（生产环境务必修改）
# JWT_SECRET=change-me-in-production

# 用户数据文件路径（默认 auth_users.json）
# AUTH_USERS_FILE=auth_users.json

# 站点监控数据文件
# MONITOR_STORE_FILE=monitor_store.json

# 私人导航数据（默认模板 private_nav_default.json，Docker 须挂载或打入镜像）
# PRIVATE_NAV_STORE_FILE=private_nav_store.json
# PRIVATE_NAV_DEFAULT_FILE=private_nav_default.json

# 云笔记
# NOTES_STORE_FILE=notes_store.json

# DeepSeek（笔记 Markdown AI 助手；用户也可在「云笔记 → AI 设置」自行填写秘钥，优先于下方环境变量）
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 用户上传目录（默认 data/uploads；Docker 挂载 ./data/uploads -> /app/uploads）
# UPLOAD_ROOT=data/uploads
# 单文件上限（字节，默认 200MB）
# UPLOAD_MAX_FILE_BYTES=209715200
# 用户总配额（字节，默认 5GB）
# UPLOAD_QUOTA_BYTES=5368709120
